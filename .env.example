# Backend the dev server proxies /api to (vite.config.ts)
VITE_API_PROXY_TARGET=https://deid-api.onrender.com
# Leave empty to call the same-origin /api (dev proxy / production rewrite).
# Set a full URL (https://deid-api.onrender.com/api) only if the backend uses
# COOKIE_SAMESITE=none + COOKIE_SECURE=true and APP_URL is this frontend's origin.
VITE_API_URL=
# Public /health of the detection service; the app pings it to wake the
# free Render instance (src/api/wakeDetection.ts). Empty: no ping.
VITE_PRESIDIO_WAKE_URL=https://deid-presidio.onrender.com/health
